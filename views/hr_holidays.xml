<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="edit_holiday_status_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='time_type']" position="before">
<!--                <field name="daily_mission" invisible="request_unit in ['hour', 'half_day']"/>-->

                <label for="daily_mission" invisible="request_unit in ['hour', 'half_day']"/>
                <div class="o_row " invisible="request_unit in ['hour', 'half_day']">
                    <field name="daily_mission" />
                    <field name="daily_mission_calendar" invisible="not daily_mission" />

                </div>
                <field name="daily_mission_validators" widget="many2many_avatar_user" invisible="not daily_mission"/>
                <label for="hourly_mission" invisible="request_unit in ['day', 'half_day']"/>
                <div class="o_row " invisible="request_unit in ['day', 'half_day']">
                    <field name="hourly_mission" />
                    <field name="hourly_mission_calendar" invisible="not hourly_mission" />

                </div>
            </xpath>


        </field>
    </record>

    <record id="hr_leave_view_form_manager_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='request_unit_half']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='request_unit_hours']" position="attributes">
                <attribute name="class">ms-0</attribute>
            </xpath>

        </field>
    </record>

    <record id="hr_leave_view_tree_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.tree.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-info">write_date &gt; (datetime.datetime.now() - datetime.timedelta(hours=3, minutes=32)).strftime('%Y-%m-%d %H:%M:%S')</attribute>

            </xpath>
            <xpath expr="//field[@name='activity_exception_decoration']" position="before">

                <field name="mission_validate" widget="badge" invisible="mission_validate in ['draft']"
                       decoration-danger="mission_validate == 'reject'"
                       decoration-success="mission_validate == 'validate'"
                />
                <field name="report_state" widget="badge" invisible="report_state in ['draft']"
                    decoration-warning="report_state == 'reported'"
                    decoration-success="report_state == 'approved'"
                />
                <field name="registered" widget="boolean_toggle" groups="hr_holidays.group_hr_holidays_manager"/>
            </xpath>


        </field>
    </record>

    <record id="view_hr_holidays_filter_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.search.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="registered" groups="hr_holidays.group_hr_holidays_manager"/>
                <filter name="not_registered" string="Not Registered"
                        domain="[ '|','|',
                        '&amp;',
                        ('state', '=', 'validate'),
                        ('write_date', '&gt;', (datetime.datetime.now() - datetime.timedelta(hours=3, minutes=30)).strftime('%Y-%m-%d %H:%M:%S')),
                        '&amp;','&amp;',
                        ('registered', '=', False),
                        ('state', '=', 'validate'),
                        ('holiday_status_id.daily_mission', '=', False),
                        '&amp;','&amp;',
                        ('registered', '=', False),
                        ('state', '=', 'validate'),
                        ('report_state', '=', 'approved'),
                        ]"/>
                <filter name="report_approved" string="Report Approved"
                        domain="[
                        ('registered', '=', False),
                        ('state', '=', 'validate'),
                        ('report_state', '=', 'approved'),
                        ]"
                />
                
                <filter name="lsat_update" string="Last Updates"
                        domain="[
                        ('write_date', '&gt;', (datetime.datetime.now() - datetime.timedelta(hours=3, minutes=59)).strftime('%Y-%m-%d %H:%M:%S')),
                        ]"/>
                <filter name="mission_report" string="Mission Report"
                        domain="[
                        ('holiday_status_id.daily_mission', '=', True),
                        ('state', '=', 'validate'),
                        ('report_state', '=', 'draft'),
                        ]"/>
                <filter name="mission_approval" string="Mission Approval"
                        domain="[
                        ('holiday_status_id.daily_mission', '=', True),
                        ('state', '=', 'validate'),
                        ('report_state', '=', 'reported'),
                        ]"/>
                <filter name="mission_validation" string="Mission Validation"
                        domain="[
                        ('holiday_status_id.daily_mission', '=', True),
                        ('state', '=', 'validate'),
                        ('report_state', '=', 'draft'),
                        ('mission_validate', '=', 'draft'),
                        ]"/>

            </xpath>


        </field>
    </record>

    <record id="hr_leave_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">

                <div class="row col-12 m-2 " invisible="not daily_mission">
                    <div class="row col-12 mx-0 px-0">
                        <div class="o_row col-1 p-1"  invisible="state != 'confirm'"  >
                            <button name="daily_mission_detail" type="object"
                                    string="Travel" class="btn btn-secondary w-25"/>
                        </div>
                        <div class="o_row1 col-2  rounded  " string="Travel" invisible="state == 'confirm'"></div>
                        <div class="col-12 col-sm-10 px-1 border rounded">
                            <div class="row mx-0">
                                <div class="col-4 col-lg-3 p-1">
                                    <label for="project_name" string="Project"/>
                                </div>
                                <div class="col-8 col-lg-9 p-1">
                                    <field name="project_name" options="{'no_open': 1}"/>
                                </div>

                            </div>
                            <div class="row mx-0">
                                <div class="col-4 col-lg-3 p-1">
                                    <label for="departure_time" string="Departure"/>
                                </div>
                                <div class="col-4 col-lg-3 p-1">
                                    <field name="departure_city"/>
                                </div>
                                <div class="col-4 col-lg-3 p-1">
                                    <field name="departure_time"/>
                                </div>
                                <div class="col-4 col-lg-3 p-1">
                                    <field name="departure_type"/>
                                </div>
                            </div>
                            <div class="row mx-0">
                                <div class="col-4 col-lg-3 p-1">

                                    <label for="return_time" string="Return"/>
                                </div>
                                <div class="col-4 col-lg-3 p-1">
                                    <field name="return_city"/>
                                </div>
                                <div class="col-4 col-lg-3 p-1">
                                    <field name="return_time"/>
                                </div>
                                <div class="col-4 col-lg-3 p-1">
                                    <field name="return_type"/>
                                </div>
                            </div>
                            <div class="row mx-0">
                                <div class="col-4 col-lg-3 p-1">

                                    <label for="residence"/>
                                </div>
                                <div class="col-4 col-lg-3 p-1">
                                    <field name="residence"/>
                                </div>
                                <div class="col-12 col-lg-3 p-1">
                                    <field name="mission_description"/>
                                </div>
                            </div>
                        </div>

                    </div>
                    <field name="daily_mission_validators" invisible="1"/>
<!--                    <field name="report_state" invisible="1"/>-->
                    <div class="my-2 row" invisible="state !='validate' or uid not in daily_mission_validators">

                        <field name="mission_validate" invisible="1"/>
                        <button name="mission_validation" type="object" invisible="mission_validate == 'validate'"
                                context="{'mission_validate_btn': 'validate'}"
                                string="Validate" class="col-2 mx-1 btn btn-success "/>
                        <div class="col bg-success-light p-1 text-center rounded-3" invisible="mission_validate != 'validate'">Mission is validated</div>
                        <div class="col bg-danger-light p-1 text-center rounded-3" invisible="mission_validate != 'reject'">Mission is rejected</div>
                        <button name="mission_validation" type="object" invisible="mission_validate == 'reject' or report_state != 'draft'"
                                context="{'mission_validate_btn': 'reject'}"
                                string="Reject" class="col-2 mx-1 btn btn-outline-danger"/>
                    </div>
                    <div class="row col-12 mx-0 mt-2 px-0 p-2 border-top " invisible="state != 'validate' or mission_validate != 'validate'">
                        <div class="o_row col-1 px-1 ">
                            <button name="daily_mission_report" type="object"
                                string="Report" class="btn btn-secondary w-25"/>
                        </div>
                        <div class="col o_row mx-1">
                            <button string="Reported" type="object" name="report_approval" class="btn btn-info"
                                    invisible="report_state != 'draft'"
                                    context="{'approval_btn': 'reported'}"/>
                            <button string="Approve" type="object" name="report_approval" class="btn btn-success"
                                    invisible="report_state != 'reported'"
                                    context="{'approval_btn': 'approved'}"/>
                            <button string="Return" type="object" name="report_approval" class="btn btn-warning"
                                    invisible="report_state in ['draft', 'registered'] "
                                    context="{'approval_btn': 'return'}"/>
                            <button string="Return" type="object" name="report_approval" class="btn btn-warning"
                                    invisible="report_state not in ['registered'] "
                                    groups="hr_holidays.group_hr_holidays_user"
                                    context="{'approval_btn': 'return'}"/>
                        </div>
                        <div class="col px-1 align-content-center text-end">
                            <field name="report_state" readonly="1" class="py-1 px-3" widget="badge"
                                   decoration-info="report_state == 'reported'"
                                   decoration-success="report_state == 'approved'"

                            />
                        </div>
                    </div>
                </div>


            </xpath>
            <xpath expr="//field[@name='request_unit_half']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='request_unit_hours']" position="attributes">
                <attribute name="class">ms-0</attribute>
            </xpath>
        </field>
    </record>



