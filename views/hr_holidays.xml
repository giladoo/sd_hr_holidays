<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="edit_holiday_status_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='time_type']" position="before">
                <field name="daily_mission" invisible="request_unit == 'hour'"/>
                <label for="hourly_mission"  invisible="request_unit == 'day'"/>
                <div class="o_row">
                    <field name="hourly_mission" invisible="request_unit == 'day'"/>
                    <field name="hourly_mission_calendar" invisible="request_unit == 'day'"/>

                </div>
            </xpath>


        </field>
    </record>

 <record id="hr_leave_view_form_manager_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='request_unit_half']" position="attributes">
                    <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='request_unit_hours']" position="attributes">
                    <attribute name="class">ms-0</attribute>
            </xpath>

        </field>
    </record>

    <record id="hr_leave_view_tree_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.tree.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_exception_decoration']" position="before">
                    <field name="registered" widget="boolean_toggle" groups="hr_holidays.group_hr_holidays_manager"/>
            </xpath>


        </field>
    </record>

    <record id="view_hr_holidays_filter_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.search.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_holidays_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                    <field name="registered" groups="hr_holidays.group_hr_holidays_manager"/>
                <filter name="not_registered" string="Not Registered" domain="[('registered', '=', False),('state', '=', 'validate'), ]"/>
            </xpath>


        </field>
    </record>

 <record id="hr_leave_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                    <group>
                    <button name="daily_mission_detail" type="object" string="Detail" class="btn btn-secondary w-25"/>
                        <field name="departure_time"/>
                        <field name="departure_type"/>
                        <field name="return_time"/>
                        <field name="return_type"/>
                        <field name="residence"/>
                        <field name="mission_description"/>
                    </group>


            </xpath>
            <xpath expr="//field[@name='request_unit_half']" position="attributes">
                    <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='request_unit_hours']" position="attributes">
                    <attribute name="class">ms-0</attribute>
            </xpath>
        </field>
    </record>


</odoo>